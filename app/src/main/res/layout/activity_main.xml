<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/windowBackground"
    android:fillViewport="true">

    <LinearLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:orientation="vertical"
        android:paddingBottom="24dp"
        android:focusable="true"
        android:focusableInTouchMode="true"
        tools:context=".View.MainActivity">

        <!-- Cabeçalho com MaterialCardView para um visual mais moderno -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="24dp"
            app:cardBackgroundColor="@color/azul_principal"
            app:cardCornerRadius="12dp"
            app:cardElevation="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:gravity="center"
                android:orientation="horizontal"
                android:padding="16dp">

                <TextView
                    android:id="@+id/labelTitulo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/titulo"
                    android:textColor="@color/white"
                    android:textSize="28sp"
                    android:textStyle="bold" />

                <ImageView
                    android:id="@+id/imageView"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:layout_marginStart="5dp"
                    app:srcCompat="@drawable/ic_app"
                    app:tint="@color/white" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Indicador de Passo -->
        <TextView
            android:id="@+id/txtIndicadorPasso"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_badge_passo"
            android:paddingHorizontal="24dp"
            android:paddingVertical="8dp"
            android:text="@string/label_produto_1"
            android:textAllCaps="true"
            android:textColor="@color/white"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- Preço Principal -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="8dp"
            android:text="@string/preco"
            android:textColor="?attr/colorOnSurface" />

        <EditText
            android:id="@+id/editTxtPreco"
            android:layout_width="200dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:drawableEnd="@android:drawable/ic_menu_camera"
            android:drawablePadding="8dp"
            android:hint="@string/Rs_0"
            android:inputType="numberDecimal"
            android:minHeight="48dp"
            android:textAlignment="center"
            android:textColor="?attr/colorOnSurface"
            android:textSize="22sp"
            android:textStyle="bold" />

        <!-- Opções de Conversão -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="12dp"
            android:text="@string/label_opcoes_conversao"
            android:textColor="?android:attr/textColorSecondary" />

        <RadioGroup
            android:id="@+id/radioGroupTipoConversao"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:gravity="center"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/radioBtnPeso"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="@string/label_peso" />

            <RadioButton
                android:id="@+id/radioBtnVolume"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_volume" />

            <RadioButton
                android:id="@+id/radioBtnUnidades"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_unidades" />
        </RadioGroup>

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switchMetricaReduzida"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="8dp"
            android:text="@string/label_metrica_reduzida"
            android:visibility="visible" />

        <!-- CORREÇÃO: Inputs Lado a Lado usando Layout Weight (Responsivo) -->
        <LinearLayout
            android:id="@+id/linearPesoUnidad"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/editTxtPeso"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="@string/hint_Peso"
                android:inputType="numberDecimal"
                android:textAlignment="center"
                android:textColor="?attr/colorOnSurface" />

            <EditText
                android:id="@+id/editTxtUnid"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="@string/hint_Unid"
                android:inputType="number"
                android:textAlignment="center"
                android:textColor="?attr/colorOnSurface" />

            <EditText
                android:id="@+id/editTxtVolume"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="@string/hint_Volume"
                android:inputType="numberDecimal"
                android:textAlignment="center"
                android:textColor="?attr/colorOnSurface" />
        </LinearLayout>

        <Button
            android:id="@+id/btnCalcular"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_margin="16dp"
            android:backgroundTint="@color/verde_acao"
            android:text="@string/btnCalcular"
            android:textColor="@color/white"
            android:textStyle="bold" />

        <!-- Resultado -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="@string/resultado"
            android:textColor="?android:attr/textColorSecondary" />

        <EditText
            android:id="@+id/editTxtResultado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="32dp"
            android:layout_marginEnd="32dp"
            android:background="@android:color/transparent"
            android:focusable="false"
            android:hint="@string/hint_Resultado"
            android:inputType="none"
            android:textAlignment="center"
            android:textColor="@color/verde_acao"
            android:textSize="28sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnLimpar"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:text="@string/btnLimpar" />

        <!-- Histórico com visual melhorado -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="24dp"
            android:text="@string/ultimos_resultados"
            android:textColor="?attr/colorOnSurface"
            android:textSize="18sp"
            android:textStyle="bold" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            app:cardCornerRadius="8dp"
            app:cardElevation="4dp"
            app:strokeWidth="1dp"
            app:strokeColor="?attr/colorOutlineVariant">

            <LinearLayout
                android:id="@+id/layoutHistoricoResultados"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="8dp">
                <!-- Linhas dinâmicas inseridas pelo Java -->
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Botão de Compartilhar (Posição estratégica) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCompartilhar"
            style="@style/Widget.MaterialComponents.Button.TextButton.Icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginBottom="16dp"
            android:text="@string/compartilhar_dica"
            android:textColor="@color/azul_principal"
            app:icon="@android:drawable/ic_menu_share"
            app:iconTint="@color/azul_principal"
            android:visibility="gone" />

        <TextView
            android:id="@+id/txtRodape"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp"
            android:paddingBottom="16dp"
            android:text="@string/rodapeTexto"
            android:textColor="?android:attr/textColorTertiary"
            android:textSize="11sp" />
    </LinearLayout>
</ScrollView>